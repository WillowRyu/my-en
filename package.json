    "eslint": "10.12.0", "eslint-plugin-react-hooks": "7.1.1", "eslint-plugin-react-refresh": "0.5.7",
    "typescript": "6.0.3", "typescript-eslint": "8.71.0", "vite": "8.3.2", "vitest": "5.0.3"
  }
